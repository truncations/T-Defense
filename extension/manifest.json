{
  "manifest_version": 3,
  "name": "T-Defense Page Guard",
  "version": "0.4.0",
  "minimum_chrome_version": "120",
  "description": "Opt-in live page checks with local-backend phishing warnings. No passwords or form values collected.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "T-Defense \u2014 continuous monitoring",
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}